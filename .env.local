# ============================================
# 自部署模式 - Vercel 纯前端部署专用
# ============================================

# 【必填】开启自部署模式，使用本地单机账号
NEXT_PUBLIC_SELF_HOSTED_MODE=true

# ============================================
# 以下全部留空（不需要填写）
# ============================================

# Supabase 云端功能（不需要）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 账号门禁密钥（不需要）
ACCOUNT_GATE_SECRET=

# 管理后台密钥（不需要）
VERIFY_ADMIN_KEY=
APP_MARKET_ADMIN_KEY=

# Supabase 前端密钥（不需要）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 第三方 API 密钥（不需要）
TRIPO_API_KEY=
IMGBB_API_KEY=
WEIXIN_PROXY=
NEXT_PUBLIC_IMAGE_GEN_PROXY_URL=

# 网易云音乐 API（不需要）
NEXT_PUBLIC_DEFAULT_NETEASE_API_BASE=
NEXT_PUBLIC_LEGACY_NETEASE_API_BASES=
NEXT_PUBLIC_NETEASE_REAL_IP=
